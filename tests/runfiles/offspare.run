#
# DEBUG: repeat zpool_offline_spare alone. Run with
# zfs-tests.sh -r offspare -I <n>.
#

[DEFAULT]
pre = setup
quiet = False
pre_user = root
user = root
timeout = 600
post_user = root
post = cleanup
failsafe_user = root
failsafe = callbacks/zfs_failsafe
tags = ['functional']

[tests/functional/cli_root/zpool_offline]
tests = ['zpool_offline_spare']
tags = ['functional', 'cli_root', 'zpool_offline']
